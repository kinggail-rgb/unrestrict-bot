# Telegram application credentials from https://my.telegram.org
API_ID=
API_HASH=

# Optional. The session is created by `gen-session` and stored in the database
# (the /data volume). Set this only to import an existing session on first run
# (a native SESSION_STRING or a Telethon STRING_SESSION).
SESSION_STRING=

# Chat to watch: "me" (Saved Messages), an @username, or a numeric id.
CONTROL_CHAT=me

# Optional: also serve the classic "DM the bot a link" flow.
BOT_TOKEN=

LOG_FORMAT=text
LOG_LEVEL=info
